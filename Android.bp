android_app {
    name: "FDECuratedApps",
    srcs: ["**/*.kt","**/*.java"],
	resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
	static_libs: [
	    "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "androidx.legacy_legacy-support-v13",
		"androidx.cardview_cardview",
		"androidx-constraintlayout_constraintlayout",
        "down_static_libs",
		"kotlinx-coroutines-android",
        "kotlinx-coroutines-core",
		"kotlin-stdlib",
        // AppFunctions (androidx) for exposing the curated apps store to AppFunction clients.
        // The appfunctions-service AAR manifest is merged in automatically, registering the
        // PlatformAppFunctionService / ExtensionAppFunctionService.
        "androidx.appfunctions_appfunctions",
        "androidx.appfunctions_appfunctions-service",
    ],
	libs: [
        // Only needed at link time to resolve optional deps from the support library.
        "com.android.extensions.appfunctions.stubs",
    ],
    plugins: ["androidx.appfunctions_appfunctions-compiler-plugin"],
    // Soong equivalent of gradle's `ksp { arg("appfunctions:aggregateAppFunctions", "true") }`.
    // Tells the appfunctions KSP compiler to also run the aggregation pass, which generates the
    // $AggregatedAppFunctionInventory_Impl / $AggregatedAppFunctionInvoker_Impl runtime classes
    // (required by androidx.appfunctions.service) and the aggregate metadata XMLs. Without this
    // the functions are never registered and `cmd app_function list-app-functions` shows nothing.
    // NOTE: 4 backslashes in Blueprint -> 2 in ninja -> 1 in argv, so the KSP option key is
    // parsed as `appfunctions:aggregateAppFunctions` (the colon must be escaped, otherwise the
    // KSP client splits on ':' and the option is silently dropped).
    annotation_processor_flags: ["appfunctions\\\\:aggregateAppFunctions=true"],
    kotlincflags: ["-Xjvm-default=all"],
    enable_ksp: true, // required for appfunctions
    optional_uses_libs: ["com.android.extensions.appfunctions"],
	manifest: "AndroidManifest.xml",
}
